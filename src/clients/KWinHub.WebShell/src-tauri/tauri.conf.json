{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KWinHub WebShell",
  "version": "0.1.0",
  "identifier": "com.kunwei.kwinhub.webshell",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "npm run build:frontends"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KWinHub WebShell",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
